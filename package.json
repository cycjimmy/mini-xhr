{
  "name": "@cycjimmy/mini-xhr",
  "type": "module",
  "version": "8.0.0",
  "description": "A very lightweight javascript library for HTTP requests.",
  "browser": "dist/mini-xhr.umd.min.js",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/mini-xhr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/mini-xhr.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/mini-xhr/issues"
  },
  "keywords": [
    "mini",
    "xmlHttpRequest",
    "promise"
  ],
  "sideEffects": false,
  "exports": {
    "import": "./dist/mini-xhr.esm.js",
    "default": "./dist/mini-xhr.esm.js"
  },
  "main": "dist/mini-xhr.esm.js",
  "module": "dist/mini-xhr.esm.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "dev:umd": "vite --mode umd-demo",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"static/**/*.css\"",
    "lint:style:fix": "stylelint \"static/**/*.css\" --fix",
    "build": "trash dist && npm run build:esm && npm run build:umd && npm run build:umd:min",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:umd:min": "vite build --mode umd-min",
    "package": "trash .release && npm run build && node tasks/copyFiles.js && node tasks/handlePackageJson.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cycjimmy/config-lib": "^3.2.1",
    "@jest/globals": "^30.1.2",
    "cross-env": "^10.0.0",
    "eslint": "^10.14.0",
    "form-data": "^4.0.0",
    "fs-extra": "^11.2.0",
    "globals": "^17.13.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "stylelint": "^17.16.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.51.2",
    "trash-cli": "^7.2.0",
    "vite": "^8.3.5"
  }
}
